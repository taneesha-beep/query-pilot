# Working document, deliberately not part of the repository.
AGENT-ROADMAP.md

# Substrate: databases and downloaded archives are acquired, never committed.
data/

# Run output: ledgers and transcripts. Only derived summaries are committed.
# Anchored with a leading slash: an unanchored `runs/` also matches `config/runs/`, where
# the committed run declarations live, and would have made them silently untracked.
/runs/

# Secrets.
.env

# Environments and caches.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# macOS.
.DS_Store
